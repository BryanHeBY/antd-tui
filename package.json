{
  "name": "antd-tui",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test packages",
    "examples:calc": "bun packages/engine/src/cli.ts --schema examples/calculator.schema.json",
    "examples:calc:dry": "bun packages/engine/src/cli.ts --schema examples/calculator.schema.json --dry-run",
    "examples:deploy": "bun packages/engine/src/cli.ts --schema examples/deploy-config.schema.json",
    "examples:deploy:dry": "bun packages/engine/src/cli.ts --schema examples/deploy-config.schema.json --dry-run",
    "examples:dash": "bun packages/engine/src/cli.ts --schema examples/service-dashboard.schema.json",
    "examples:dash:dry": "bun packages/engine/src/cli.ts --schema examples/service-dashboard.schema.json --dry-run",
    "vibe:mock": "bun packages/vibe-tui/src/cli.ts --agent \"bun packages/vibe-tui/tests/mock-agent.ts\"",
    "build:bin": "bun build --compile packages/engine/src/cli.ts --outfile dist/antd-tui-engine"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
