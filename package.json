{
  "name": "antd-tui",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test packages",
    "examples:calc": "bun packages/engine/src/cli.ts --schema examples/schema/calculator.json",
    "examples:calc:dry": "bun packages/engine/src/cli.ts --schema examples/schema/calculator.json --dry-run",
    "examples:calc:repl": "bun examples/repl/calculator.tsx",
    "examples:deploy": "bun packages/engine/src/cli.ts --schema examples/schema/deploy-config.json",
    "examples:deploy:dry": "bun packages/engine/src/cli.ts --schema examples/schema/deploy-config.json --dry-run",
    "examples:deploy:repl": "bun examples/repl/deploy-config.tsx",
    "examples:dash": "bun packages/engine/src/cli.ts --schema examples/schema/service-dashboard.json",
    "examples:dash:dry": "bun packages/engine/src/cli.ts --schema examples/schema/service-dashboard.json --dry-run",
    "examples:dash:repl": "bun examples/repl/service-dashboard.tsx",
    "vibe:mock": "bun packages/vibe-tui/src/cli.ts --agent \"bun packages/vibe-tui/tests/mock-agent.ts\"",
    "build:bin": "bun build --compile packages/engine/src/cli.ts --outfile dist/antd-tui-engine"
  },
  "devDependencies": {
    "@antd-tui/components": "workspace:*",
    "@antd-tui/live": "workspace:*",
    "@opentui/core": "latest",
    "@opentui/react": "latest",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
