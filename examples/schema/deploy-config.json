{
  "version": "0.1",
  "page": {
    "title": "服务部署配置",
    "description": "Tab/方向键移动焦点，填写后点击「部署」提交，Esc 取消",
    "mode": "form"
  },
  "form": {
    "type": "object",
    "properties": {
      "basicCard": {
        "type": "void",
        "x-component": "Card",
        "x-component-props": { "title": "基础信息" },
        "properties": {
          "name": {
            "type": "string",
            "title": "服务名称",
            "required": true,
            "x-validator": {
              "pattern": "^[a-z][a-z0-9-]*$",
              "message": "仅允许小写字母、数字与中划线，且以字母开头"
            },
            "x-decorator": "FormItem",
            "x-component": "Input",
            "x-component-props": { "placeholder": "如 user-api" }
          },
          "rowEnvPort": {
            "type": "void",
            "x-component": "Row",
            "x-component-props": { "gutter": 2 },
            "properties": {
              "colEnv": {
                "type": "void",
                "x-component": "Col",
                "x-component-props": { "flex": 1 },
                "properties": {
                  "env": {
                    "type": "string",
                    "title": "部署环境",
                    "default": "dev",
                    "enum": [
                      { "label": "开发", "value": "dev" },
                      { "label": "测试", "value": "test" },
                      { "label": "生产", "value": "prod" }
                    ],
                    "x-decorator": "FormItem",
                    "x-component": "Select"
                  }
                }
              },
              "colPort": {
                "type": "void",
                "x-component": "Col",
                "x-component-props": { "flex": 1 },
                "properties": {
                  "port": {
                    "type": "number",
                    "title": "服务端口",
                    "default": 8080,
                    "x-decorator": "FormItem",
                    "x-component": "InputNumber",
                    "x-component-props": { "placeholder": "1-65535" },
                    "x-validator": { "minimum": 1, "maximum": 65535, "message": "端口范围 1-65535" }
                  }
                }
              }
            }
          },
          "region": {
            "type": "string",
            "title": "部署地域",
            "default": "cn-north",
            "enum": [
              { "label": "华北", "value": "cn-north" },
              { "label": "华东", "value": "cn-east" },
              { "label": "华南", "value": "cn-south" }
            ],
            "x-decorator": "FormItem",
            "x-component": "Radio.Group",
            "x-component-props": { "optionType": "button" }
          },
          "features": {
            "type": "array",
            "title": "附加能力",
            "default": ["log"],
            "enum": [
              { "label": "日志采集", "value": "log" },
              { "label": "链路追踪", "value": "trace" },
              { "label": "自动扩缩容", "value": "autoscale" }
            ],
            "x-decorator": "FormItem",
            "x-component": "Checkbox.Group",
            "x-component-props": { "tuiDirection": "horizontal" }
          }
        }
      },
      "dividerAdvanced": {
        "type": "void",
        "x-component": "Divider",
        "x-content": "高级选项",
        "x-component-props": { "orientation": "left" }
      },
      "advanced": {
        "type": "boolean",
        "title": "启用高级配置",
        "default": false,
        "x-decorator": "FormItem",
        "x-component": "Switch",
        "x-component-props": {
          "checkedChildren": "开",
          "unCheckedChildren": "关"
        }
      },
      "advancedCard": {
        "type": "void",
        "x-component": "Card",
        "x-component-props": { "title": "高级配置" },
        "x-reactions": {
          "dependencies": ["advanced"],
          "fulfill": {
            "state": { "visible": "{{ $deps[0] === true }}" }
          }
        },
        "properties": {
          "cpuLimit": {
            "type": "number",
            "title": "CPU 上限 (%)",
            "default": 50,
            "x-decorator": "FormItem",
            "x-component": "Slider",
            "x-component-props": { "min": 10, "max": 100, "step": 5 }
          },
          "startupScript": {
            "type": "string",
            "title": "启动脚本",
            "x-decorator": "FormItem",
            "x-component": "TextArea",
            "x-component-props": {
              "rows": 3,
              "placeholder": "#!/bin/sh\n每行一条命令"
            }
          },
          "autoRestart": {
            "type": "boolean",
            "default": true,
            "x-decorator": "FormItem",
            "x-component": "Checkbox",
            "x-content": "崩溃后自动重启"
          }
        }
      }
    }
  },
  "actions": [
    { "type": "submit", "label": "部署" },
    { "type": "cancel", "label": "取消" }
  ]
}
