{
  "version": "0.1",
  "page": {
    "title": "TUI 计算器",
    "description": "鼠标点击 / 方向键 / 数字热键，逻辑全由 schema scope 函数驱动",
    "mode": "interactive"
  },
  "scope": {
    "pressDigit": "{{ (d) => { const s = $form.values.display; if ($memo.justEvaluated) { $memo.justEvaluated = false; $form.setValuesIn('display', d); return } if (s.slice(-1) === '%') return; $form.setValuesIn('display', s === '0' || s === '错误' ? d : s + d) } }}",
    "pressOp": "{{ (op) => { const s = $form.values.display; if (s === '错误') return; $memo.justEvaluated = false; const t = '+-×÷'.includes(s.slice(-1)) ? s.slice(0, -1) : s; $form.setValuesIn('display', t + op) } }}",
    "pressDot": "{{ () => { const s = $form.values.display; if (s === '错误' || $memo.justEvaluated) { $memo.justEvaluated = false; $form.setValuesIn('display', '0.'); return } const seg = s.split(/[+\\-×÷%]/).pop(); if (seg.includes('.')) return; $form.setValuesIn('display', seg === '' ? s + '0.' : s + '.') } }}",
    "pressPercent": "{{ () => { const s = $form.values.display; if (s === '错误' || '+-×÷%.'.includes(s.slice(-1))) return; $memo.justEvaluated = false; $form.setValuesIn('display', s + '%') } }}",
    "clearAll": "{{ () => { $memo.justEvaluated = false; $form.setValuesIn('display', '0') } }}",
    "deleteOne": "{{ () => { const s = $form.values.display; $memo.justEvaluated = false; $form.setValuesIn('display', s === '错误' || s.length <= 1 ? '0' : s.slice(0, -1)) } }}",
    "evaluate": "{{ () => { const s = $form.values.display; if (s === '错误') return; try { const r = Function('return (' + s.replace(/×/g, '*').replace(/÷/g, '/').replace(/%/g, '/100') + ')')(); $form.setValuesIn('display', Number.isFinite(r) ? String(Math.round(r * 1e10) / 1e10) : '错误'); $memo.justEvaluated = true } catch (e) { $form.setValuesIn('display', '错误'); $memo.justEvaluated = false } } }}"
  },
  "form": {
    "type": "object",
    "properties": {
      "calculator": {
        "type": "void",
        "x-component": "Flex",
        "x-component-props": { "vertical": true, "gap": 0, "style": { "width": "100%" } },
        "properties": {
          "screen": {
            "type": "void",
            "x-component": "Flex",
            "x-component-props": {
              "vertical": true,
              "align": "flex-end",
              "style": { "marginRight": 2, "backgroundColor": "#1f1f1f", "padding": 1 }
            },
            "properties": {
              "display": {
                "type": "string",
                "default": "0",
                "x-component": "Typography.Text",
                "x-component-props": { "type": "warning", "strong": true }
              }
            }
          },
          "keypad": {
            "type": "void",
            "x-component": "Button.Group",
            "x-component-props": { "block": true, "tuiBordered": true },
            "properties": {
              "rowTop": {
                "type": "void", "x-component": "Row", "x-component-props": { "gutter": 0, "wrap": false },
                "properties": {
                  "clearCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btnClear": { "type": "void", "x-component": "Button", "x-content": "AC", "x-component-props": { "tuiHotkey": "c", "tuiOnClick": "{{ () => clearAll() }}" } } } },
                  "deleteCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btnDelete": { "type": "void", "x-component": "Button", "x-content": "DEL", "x-component-props": { "tuiHotkey": "backspace", "tuiOnClick": "{{ () => deleteOne() }}" } } } },
                  "percentCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btnPercent": { "type": "void", "x-component": "Button", "x-content": "%", "x-component-props": { "tuiHotkey": "%", "tuiOnClick": "{{ () => pressPercent() }}" } } } },
                  "divideCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btnDivide": { "type": "void", "x-component": "Button", "x-content": "÷", "x-component-props": { "type": "primary", "tuiHotkey": "/", "tuiOnClick": "{{ () => pressOp('÷') }}" } } } }
                }
              },
              "rowSeven": {
                "type": "void", "x-component": "Row", "x-component-props": { "gutter": 0, "wrap": false },
                "properties": {
                  "sevenCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btn7": { "type": "void", "x-component": "Button", "x-content": "7", "x-component-props": { "tuiHotkey": "7", "tuiOnClick": "{{ () => pressDigit('7') }}" } } } },
                  "eightCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btn8": { "type": "void", "x-component": "Button", "x-content": "8", "x-component-props": { "tuiHotkey": "8", "tuiOnClick": "{{ () => pressDigit('8') }}" } } } },
                  "nineCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btn9": { "type": "void", "x-component": "Button", "x-content": "9", "x-component-props": { "tuiHotkey": "9", "tuiOnClick": "{{ () => pressDigit('9') }}" } } } },
                  "multiplyCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btnMultiply": { "type": "void", "x-component": "Button", "x-content": "×", "x-component-props": { "type": "primary", "tuiHotkey": "*", "tuiOnClick": "{{ () => pressOp('×') }}" } } } }
                }
              },
              "rowFour": {
                "type": "void", "x-component": "Row", "x-component-props": { "gutter": 0, "wrap": false },
                "properties": {
                  "fourCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btn4": { "type": "void", "x-component": "Button", "x-content": "4", "x-component-props": { "tuiHotkey": "4", "tuiOnClick": "{{ () => pressDigit('4') }}" } } } },
                  "fiveCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btn5": { "type": "void", "x-component": "Button", "x-content": "5", "x-component-props": { "tuiHotkey": "5", "tuiOnClick": "{{ () => pressDigit('5') }}" } } } },
                  "sixCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btn6": { "type": "void", "x-component": "Button", "x-content": "6", "x-component-props": { "tuiHotkey": "6", "tuiOnClick": "{{ () => pressDigit('6') }}" } } } },
                  "subtractCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btnSubtract": { "type": "void", "x-component": "Button", "x-content": "-", "x-component-props": { "type": "primary", "tuiHotkey": "-", "tuiOnClick": "{{ () => pressOp('-') }}" } } } }
                }
              },
              "rowOne": {
                "type": "void", "x-component": "Row", "x-component-props": { "gutter": 0, "wrap": false },
                "properties": {
                  "oneCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btn1": { "type": "void", "x-component": "Button", "x-content": "1", "x-component-props": { "tuiHotkey": "1", "tuiOnClick": "{{ () => pressDigit('1') }}" } } } },
                  "twoCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btn2": { "type": "void", "x-component": "Button", "x-content": "2", "x-component-props": { "tuiHotkey": "2", "tuiOnClick": "{{ () => pressDigit('2') }}" } } } },
                  "threeCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btn3": { "type": "void", "x-component": "Button", "x-content": "3", "x-component-props": { "tuiHotkey": "3", "tuiOnClick": "{{ () => pressDigit('3') }}" } } } },
                  "addCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btnAdd": { "type": "void", "x-component": "Button", "x-content": "+", "x-component-props": { "type": "primary", "tuiHotkey": "+", "tuiOnClick": "{{ () => pressOp('+') }}" } } } }
                }
              },
              "rowZero": {
                "type": "void", "x-component": "Row", "x-component-props": { "gutter": 0, "wrap": false },
                "properties": {
                  "zeroCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 2 }, "properties": { "btn0": { "type": "void", "x-component": "Button", "x-content": "0", "x-component-props": { "tuiHotkey": "0", "tuiOnClick": "{{ () => pressDigit('0') }}" } } } },
                  "dotCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btnDot": { "type": "void", "x-component": "Button", "x-content": ".", "x-component-props": { "tuiHotkey": ".", "tuiOnClick": "{{ () => pressDot() }}" } } } },
                  "equalsCol": { "type": "void", "x-component": "Col", "x-component-props": { "flex": 1 }, "properties": { "btnEquals": { "type": "void", "x-component": "Button", "x-content": "=", "x-component-props": { "type": "primary", "tuiHotkey": "=", "tuiOnClick": "{{ () => evaluate() }}" } } } }
                }
              }
            }
          }
        }
      }
    }
  }
}
