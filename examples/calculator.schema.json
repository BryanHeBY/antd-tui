{
  "version": "0.1",
  "page": {
    "title": "TUI 计算器",
    "description": "鼠标点击 / 方向键 / 数字热键，逻辑全由 schema scope 函数驱动",
    "mode": "interactive"
  },
  "scope": {
    "pressDigit": "{{ (d) => { const s = $form.values.display; if ($memo.justEvaluated) { $memo.justEvaluated = false; $form.setValuesIn('display', d); return } if (s.slice(-1) === '%') return; $form.setValuesIn('display', s === '0' || s === '错误' ? d : s + d) } }}",
    "pressOp": "{{ (op) => { const s = $form.values.display; if (s === '错误') return; $memo.justEvaluated = false; const t = '+-×÷'.includes(s.slice(-1)) ? s.slice(0, -1) : s; $form.setValuesIn('display', t + op) } }}",
    "pressDot": "{{ () => { const s = $form.values.display; if (s === '错误' || $memo.justEvaluated) { $memo.justEvaluated = false; $form.setValuesIn('display', '0.'); return } const seg = s.split(/[+\\-×÷%]/).pop(); if (seg.includes('.')) return; $form.setValuesIn('display', seg === '' ? s + '0.' : s + '.') } }}",
    "pressPercent": "{{ () => { const s = $form.values.display; if (s === '错误' || '+-×÷%.'.includes(s.slice(-1))) return; $memo.justEvaluated = false; $form.setValuesIn('display', s + '%') } }}",
    "clearAll": "{{ () => { $memo.justEvaluated = false; $form.setValuesIn('display', '0') } }}",
    "deleteOne": "{{ () => { const s = $form.values.display; $memo.justEvaluated = false; $form.setValuesIn('display', s === '错误' || s.length <= 1 ? '0' : s.slice(0, -1)) } }}",
    "evaluate": "{{ () => { const s = $form.values.display; if (s === '错误') return; try { const r = Function('return (' + s.replace(/×/g, '*').replace(/÷/g, '/').replace(/%/g, '/100') + ')')(); $form.setValuesIn('display', Number.isFinite(r) ? String(Math.round(r * 1e10) / 1e10) : '错误'); $memo.justEvaluated = true } catch (e) { $form.setValuesIn('display', '错误'); $memo.justEvaluated = false } } }}"
  },
